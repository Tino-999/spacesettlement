/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spacesettlement-api-staging",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-30",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public"
	},
"observability": {
  "enabled": true
},

"d1_databases": [
  {
    "binding": "DB",
    "database_name": "spacesettlement-db",
    "database_id": "f899bfb4-d418-41b5-8bc8-30b4fb06f6cd"
  }
],

"r2_buckets": [
  {
    "binding": "IMAGES",
    "bucket_name": "spacesettlement-image"
  }
],

/**
 * Produktion.
 *
 * Die Seite spricht mit dem Worker "spacesettlement-api" (siehe
 * data/config.json), die Konfiguration oben traegt aber den Namen
 * "spacesettlement-api-staging". Deshalb ist Produktion hier als eigene
 * Umgebung ausgewiesen, statt den Namen oben stillschweigend zu aendern:
 *
 *   npx wrangler deploy --env production
 *
 * Die Routen holen genau drei Pfade unter space-settlement.net an diesen
 * Worker; alles andere bleibt beim bisherigen Hosting der Seite. Eine
 * engere Route gewinnt in Cloudflare gegen eine weitere, deshalb greift
 * das auch neben einem bestehenden Catch-all.
 *
 * Bindings werden in benannten Umgebungen nicht vererbt und sind daher
 * wiederholt.
 */
"env": {
  "production": {
    "name": "spacesettlement-api",
    // Muss gesetzt bleiben: die Seite spricht laut data/config.json ueber
    // spacesettlement-api.tinoschuldt100.workers.dev mit der API. Fehlt der
    // Schluessel, schaltet wrangler die Adresse beim Deploy ab.
    "workers_dev": true,
    "preview_urls": false,
    "routes": [
      { "pattern": "space-settlement.net/item/*", "zone_name": "space-settlement.net" },
      { "pattern": "space-settlement.net/sitemap.xml", "zone_name": "space-settlement.net" },
      { "pattern": "space-settlement.net/robots.txt", "zone_name": "space-settlement.net" }
    ],
    "vars": {
      "SITE_ORIGIN": "https://space-settlement.net"
    },
    "observability": { "enabled": true },
    "assets": { "directory": "./public" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "spacesettlement-db",
        "database_id": "f899bfb4-d418-41b5-8bc8-30b4fb06f6cd"
      }
    ],
    "r2_buckets": [
      {
        "binding": "IMAGES",
        "bucket_name": "spacesettlement-image"
      }
    ]
  }
},

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}